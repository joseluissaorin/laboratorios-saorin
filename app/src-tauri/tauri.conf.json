{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "film-look lab",
  "version": "0.1.0",
  "identifier": "com.saorin.filmlook",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "film-look lab",
        "width": 1680,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": []
  }
}
